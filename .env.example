# PostgreSQL connection string (set automatically by Railway when you add a Postgres database)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Password for the dashboard login page
APP_PASSWORD="change-me"

# Google Gemini API (optional; without a key, AI summaries are clearly labelled mock summaries)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
